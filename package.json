{
  "name": "supermortgage",
  "version": "0.1.0",
  "private": true,
  "description": "AI-first Fannie Mae subservicing platform, built to spec/",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --experimental-strip-types src/runtime/main.ts serve",
    "sweep": "node --experimental-strip-types src/runtime/main.ts sweep",
    "migrate": "node --experimental-strip-types src/runtime/main.ts migrate",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' && python3 tools/audit.py --check && python3 tools/spec_lint_names.py",
    "typecheck": "tsc --noEmit",
    "spec:extract": "python3 tools/extract_spec.py",
    "spec:lint": "node --experimental-strip-types tools/lint-registry.ts",
    "test:db": "REQUIRE_DB=1 node --test --experimental-strip-types 'src/infra/db/*.test.ts'",
    "console": "node --experimental-strip-types tools/console.ts",
    "audit": "python3 tools/spec_manifest.py && python3 tools/audit.py",
    "test:unit": "node --test --experimental-strip-types 'src/**/*.test.ts'",
    "audit:check": "python3 tools/audit.py --check",
    "audit:baseline": "python3 tools/audit.py --baseline",
    "spec:register": "python3 tools/spec_register.py",
    "spec:manifest": "python3 tools/spec_manifest.py",
    "spec:scaffold": "python3 tools/scaffold_spec_tests.py",
    "spec:lint:names": "python3 tools/spec_lint_names.py --verbose",
    "spec:import:origination": "python3 tools/import_origination.py"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "pg": "^8.23.0"
  }
}
