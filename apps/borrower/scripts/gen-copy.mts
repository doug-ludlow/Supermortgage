/**
 * Generates lib/copy/generated.ts from docs/ux/12-message-copy-library.md.
 *
 * Line format (12 §0): - `key` — **kind** — "text" — *notes*
 * Extra " — " segments after the text (what_we_get, options, footer, helper, why,
 * fallback …) are kept verbatim in `extras`. Options in the form `A` · `B` are
 * split into `options`.
 *
 * Run: npm run gen:copy   (node --experimental-strip-types scripts/gen-copy.mts; no deps)
 */
import { readFileSync, writeFileSync } from "node:fs";
import path from "node:path";

const here = path.dirname(new URL(import.meta.url).pathname);
const source = path.resolve(here, "../../../docs/ux/12-message-copy-library.md");
const target = path.resolve(here, "../lib/copy/generated.ts");

type Entry = {
  key: string;
  kind: string;
  text: string;
  notes?: string;
  extras: string[];
  options?: string[];
  section: string;
};

/** Split on " — " but never inside a "quoted" run (copy text itself contains em dashes). */
function splitOutsideQuotes(s: string): string[] {
  const out: string[] = [];
  let cur = "";
  let inQ = false;
  for (let i = 0; i < s.length; i++) {
    const ch = s[i]!;
    if (ch === '"') inQ = !inQ;
    if (!inQ && s.startsWith(DASH, i)) {
      out.push(cur);
      cur = "";
      i += DASH.length - 1;
      continue;
    }
    cur += ch;
  }
  out.push(cur);
  return out;
}

const md = readFileSync(source, "utf8");
const lines = md.split("\n");
const entries: Entry[] = [];
let section = "";
const DASH = " — ";

for (const raw of lines) {
  if (raw.startsWith("## ")) {
    section = raw.slice(3).trim();
    continue;
  }
  const m = /^- `([^`]+)`(.*)$/.exec(raw);
  if (!m) continue;
  const key = m[1]!;
  const rest = m[2]!.trim();
  // segments separated by " — " (em dash) outside double quotes; the first is the kind
  const segs = splitOutsideQuotes(rest.startsWith("—") ? rest.slice(1).trim() : rest);
  const kindRaw = (segs.shift() ?? "").trim();
  const kind = kindRaw.replace(/^\*\*|\*\*$/g, "").trim();
  let text = "";
  let notes: string | undefined;
  const extras: string[] = [];
  let options: string[] | undefined;
  for (const seg0 of segs) {
    const seg = seg0.trim();
    if (!text && /^"/.test(seg)) {
      text = seg.replace(/^"/, "").replace(/"\.?$/, "").replace(/"$/, "");
      continue;
    }
    if (/^\*[^*].*\*\.?$/.test(seg)) {
      notes = seg.replace(/^\*/, "").replace(/\*\.?$/, "");
      continue;
    }
    if (/^options? /.test(seg)) {
      options = seg
        .replace(/^options?\s+/, "")
        .replace(/\.$/, "")
        .split(" · ")
        .map((o) => o.replace(/^`|`$/g, "").trim())
        .filter(Boolean);
      // "options include `X`" — keep as extra too
      if (/^options? include/.test(seg)) extras.push(seg);
      continue;
    }
    extras.push(seg);
  }
  if (!text) {
    // some keys carry no quoted text (e.g. structure references); keep the first extra as text
    text = extras.shift() ?? "";
  }
  entries.push({ key, kind, text, notes, extras, options, section });
}

const seen = new Set<string>();
for (const e of entries) {
  if (seen.has(e.key)) throw new Error(`duplicate copy key ${e.key}`);
  seen.add(e.key);
}

const q = (s: string) => JSON.stringify(s);
const out: string[] = [];
out.push("/* GENERATED by scripts/gen-copy.ts from docs/ux/12-message-copy-library.md — do not edit. */");
out.push("/* eslint-disable */");
out.push("");
out.push("export type CopyEntry = {");
out.push("  key: string;");
out.push("  kind: string;");
out.push("  text: string;");
out.push("  notes?: string;");
out.push("  extras: readonly string[];");
out.push("  options?: readonly string[];");
out.push("  section: string;");
out.push("};");
out.push("");
out.push("export const COPY = {");
for (const e of entries) {
  const fields = [
    `key: ${q(e.key)}`,
    `kind: ${q(e.kind)}`,
    `text: ${q(e.text)}`,
    e.notes !== undefined ? `notes: ${q(e.notes)}` : "",
    `extras: [${e.extras.map(q).join(", ")}]`,
    e.options ? `options: [${e.options.map(q).join(", ")}]` : "",
    `section: ${q(e.section)}`,
  ].filter(Boolean);
  out.push(`  ${q(e.key)}: { ${fields.join(", ")} },`);
}
out.push("} as const satisfies Record<string, CopyEntry>;");
out.push("");
out.push("export type CopyKey = keyof typeof COPY;");
out.push(`export const COPY_KEY_COUNT = ${entries.length};`);
out.push("");
writeFileSync(target, out.join("\n"));
console.log(`wrote ${entries.length} copy keys to ${path.relative(process.cwd(), target)}`);
