# Supermortgage borrower app (apps/borrower) — Next.js standalone output, served at /app.
#   docker build -f Dockerfile.borrower -t supermortgage-borrower .
#   docker run -p 8080:8080 -e API_BASE_URL=https://demo.supermortgage.com -e API_TOKEN=... supermortgage-borrower
# The API token is read only by the server-side proxy route (app/api/[...path]/route.ts);
# it is never sent to the browser.

# ---- deps ------------------------------------------------------------------
FROM node:22-bookworm-slim AS deps
WORKDIR /src
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
COPY apps/borrower/package.json apps/borrower/package-lock.json ./
RUN npm ci --no-audit --no-fund && npm cache clean --force

# ---- build -----------------------------------------------------------------
FROM node:22-bookworm-slim AS build
WORKDIR /src
# The environment the bundle is built for (deploy.yml passes its ENVIRONMENT, "nonprod" by default).
# Inlined by Next as NEXT_PUBLIC_ENVIRONMENT: any value other than production turns on the FAKE
# vendor paths (apps/borrower/lib/env.ts SHOW_FAKE_MARKERS), which are the only ones that work
# against an API running INTEGRATIONS=fake. Empty (a plain docker build) means a production bundle.
ARG NEXT_PUBLIC_ENVIRONMENT=""
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production NEXT_PUBLIC_ENVIRONMENT=$NEXT_PUBLIC_ENVIRONMENT
COPY --from=deps /src/node_modules ./node_modules
COPY apps/borrower/ ./
# The copy library is generated from docs/ux/12; the generated module is committed, so the
# docs are not needed inside the image. `next build` type-checks and emits .next/standalone.
RUN npm run build

# ---- runtime ---------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=8080
# standalone = server.js + the traced node_modules; static assets and public/ are copied beside it
COPY --from=build --chown=node:node /src/.next/standalone ./
COPY --from=build --chown=node:node /src/.next/static ./.next/static
USER node
EXPOSE 8080
CMD ["node", "server.js"]
